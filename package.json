{
  "name": "zayelle-photo-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Turns product photos into two WebP sizes with Sharp — locally, in a Next.js upload UI, and in AWS Lambda on S3 upload.",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "next dev",
    "local": "tsx src/local.ts",
    "typecheck": "tsc --noEmit",
    "build:lambda": "esbuild src/handler.ts --bundle --platform=node --target=node22 --external:sharp --external:@aws-sdk/* --outfile=dist/handler.js",
    "sam:build": "npm run build:lambda && sam build --use-container",
    "deploy": "npm run sam:build && sam deploy --guided"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
